{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "white"
    },
    "key": {
      "width": 15
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣛  System"
    },
    {
      "type": "host",
      "key": "󰌢  Device"
    },
    {
      "type": "kernel",
      "key": "󰒋  Kernel"
    },
    {
      "type": "uptime",
      "key": "󰔟  Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖  Packages"
    },
    {
      "type": "wm",
      "key": "󰖯  Compositor"
    },
    {
      "type": "terminal",
      "key": "󰆍  Terminal"
    },
    {
      "type": "cpu",
      "key": "󰻠  CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU"
    },
    {
      "type": "memory",
      "key": "󰍛  Memory"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "󰍹  Display",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "battery",
      "key": "󰁹  Battery"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
