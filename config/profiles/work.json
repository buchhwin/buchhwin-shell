{
  "configVersion": 3,
  "name": "work",
  "label": "Work",
  "description": "A bar: workspaces and the active window, the time, media, status and the control center",
  "desktopMode": "pills",
  "bar": {
    "reserve": true,
    "fullscreen": "hide",
    "scale": 1,
    "style": "pills",
    "position": "floating",
    "edge": "top",
    "panelSpot": "widget",
    "notificationSpot": "widget",
    "screens": [],
    "left": [
      { "id": "pill-1", "items": [{ "type": "workspace", "display": "full", "options": {} }] },
      { "id": "pill-2", "items": [{ "type": "activeWindow", "display": "full", "options": {} }] }
    ],
    "center": [
      { "id": "pill-3", "items": [{ "type": "clock", "display": "full", "options": {} }] }
    ],
    "right": [
      { "id": "pill-4", "items": [{ "type": "nowPlaying", "display": "icon", "options": {} }] },
      { "id": "pill-5", "items": [{ "type": "network", "display": "icon", "options": {} }, { "type": "volume", "display": "icon", "options": {} }, { "type": "battery", "display": "full", "options": {} }] },
      { "id": "pill-6", "items": [{ "type": "notificationIndicator", "display": "icon", "options": {} }, { "type": "quickPanel", "display": "icon", "options": {} }] }
    ]
  },
  "widgets": [
    { "key": "clock", "type": "clock", "screen": "*", "anchorX": "right", "x": 0.985, "y": 0.02, "size": "medium", "style": "minimal" },
    { "key": "workspace", "type": "workspace", "screen": "*", "anchorX": "left", "x": 0.015, "y": 0.02, "style": "capsule" },
    { "key": "window", "type": "activeWindow", "screen": "*", "anchorX": "center", "x": 0.5, "y": 0.02, "style": "minimal" },
    { "key": "calendar", "type": "calendarSummary", "screen": "*", "anchorX": "right", "x": 0.985, "y": 0.14, "style": "card" }
  ]
}
