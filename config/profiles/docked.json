{
  "configVersion": 2,
  "name": "docked",
  "label": "Docked",
  "description": "Clock and workspaces on every display",
  "widgets": [
    { "key": "clock", "type": "clock", "screen": "*", "anchorX": "right", "x": 0.985, "y": 0.02, "size": "small", "style": "minimal" },
    { "key": "workspace", "type": "workspace", "screen": "*", "anchorX": "left", "x": 0.015, "y": 0.02, "style": "capsule" }
  ]
}
