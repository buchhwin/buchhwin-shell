{
  "configVersion": 3,
  "name": "laptop",
  "label": "Laptop",
  "description": "A slim bar along the top: workspaces, the time, the battery with its percent and unread notifications; tighter gaps",
  "desktopMode": "pills",
  "bar": {
    "reserve": true,
    "fullscreen": "hide",
    "scale": 0.9,
    "style": "bar",
    "position": "attached",
    "edge": "top",
    "panelSpot": "widget",
    "notificationSpot": "widget",
    "screens": [],
    "left": [
      { "id": "pill-1", "items": [{ "type": "workspace", "display": "full", "options": {} }] }
    ],
    "center": [
      { "id": "pill-2", "items": [{ "type": "clock", "display": "full", "options": {} }] }
    ],
    "right": [
      { "id": "pill-3", "items": [{ "type": "network", "display": "icon", "options": {} }, { "type": "volume", "display": "icon", "options": {} }, { "type": "battery", "display": "full", "options": {} }] },
      { "id": "pill-4", "items": [{ "type": "notificationIndicator", "display": "icon", "options": {} }, { "type": "quickPanel", "display": "icon", "options": {} }] }
    ]
  },
  "effects": { "gapsIn": 4, "gapsOut": 8 },
  "widgets": [
    { "key": "network", "type": "network", "screen": "*" },
    { "key": "battery", "type": "battery", "screen": "*" },
    { "key": "clock", "type": "clock", "screen": "*", "size": "small" }
  ],
  "groups": [
    { "members": ["network", "battery", "clock"], "anchorX": "right", "x": 0.985, "y": 0.02, "style": "minimal" }
  ]
}
