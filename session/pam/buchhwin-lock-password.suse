#%PAM-1.0
# buchhwin-shell lock screen, password only, on openSUSE. lock.qml switches to
# this service when the password is submitted while pam_fprintd (common-auth)
# still waits for a finger. openSUSE has no password-auth without the reader,
# so the password part of common-auth is spelled out here.
auth       required     pam_env.so
auth       required     pam_unix.so  try_first_pass
account    required     pam_permit.so
