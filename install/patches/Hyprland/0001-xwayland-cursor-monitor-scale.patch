+bool CPointerManager::cursorIsXWayland() {
+    if (!m_currentCursorImage.surface || !m_currentCursorImage.surface->resource() || !g_pXWayland || !g_pXWayland->m_server)
+        return false;
+    return m_currentCursorImage.surface->resource()->client() == g_pXWayland->m_server->m_xwaylandClient;
+}
+
+PHLMONITOR CPointerManager::monitorUnderPointer() {
+    for (auto const& m : State::monitorState()->monitors()) {
+        if (m->m_enabled && m->logicalBox().containsPoint(m_pointerPos))
+            return m;
+    }
+    return nullptr;
+}
+
+float CPointerManager::cursorImageScaleFor(PHLMONITOR pMonitor) {
+    static auto PXWLFORCESCALEZERO = CConfigValue<Config::INTEGER>("xwayland:force_zero_scaling");
+    if (*PXWLFORCESCALEZERO && pMonitor && m_currentCursorImage.scale == 1.F && cursorIsXWayland())
+        return pMonitor->m_scale;
+    return m_currentCursorImage.scale;
+}
+
+Vector2D CPointerManager::hotspotLogicalFor(PHLMONITOR pMonitor) {
+    // set_cursor hotspots are surface-local: buffer pixels divided by the surface scale.
+    const auto SCALE = cursorImageScaleFor(pMonitor);
+    if (SCALE == m_currentCursorImage.scale)
+        return m_currentCursorImage.hotspot;
+    return m_currentCursorImage.hotspot * (m_currentCursorImage.scale / SCALE);
+}
+
